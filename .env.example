# =============================================================================
# Variáveis de ambiente — copie para .env e preencha os valores
# =============================================================================

# OBRIGATÓRIA — o servidor não sobe sem esta variável definida.
# Use um valor aleatório forte (ex: openssl rand -hex 32).
# O agente também deve ter a mesma chave em API_KEY.
API_KEY=changeme-use-strong-random-value

# Webhook do Microsoft Teams via Power Automate (opcional).
# Deixe vazio para desabilitar notificações — os alertas continuam sendo
# persistidos no banco normalmente.
TEAMS_WEBHOOK_URL=

# URL de conexão com o PostgreSQL.
DATABASE_URL=postgresql://monitor:monitor@db:5432/monitor

# URL base do backend (usada pelo agente para montar as URLs de destino).
MONITOR_API_BASE_URL=http://api.monitoramento.lan

# URLs individuais dos endpoints (opcional — sobrescrevem MONITOR_API_BASE_URL).
# MONITOR_DISCOVERY_URL=http://api.monitoramento.lan/api/discovery
# MONITOR_METRICS_URL=http://api.monitoramento.lan/api/metrics
# MONITOR_LOGS_URL=http://api.monitoramento.lan/api/logs
# MONITOR_CONNECTIONS_URL=http://api.monitoramento.lan/api/connections
# MONITOR_HEARTBEAT_URL=http://api.monitoramento.lan/api/heartbeat


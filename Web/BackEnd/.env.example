# Configuração do banco de dados PostgreSQL - BIA - Quando integrar com banco real
DATABASE_URL=postgresql://app_user:senha@database:5432/monitor_db

# Ambiente de execução do Flask 
# Define o modo de execução do Flask
# development → modo desenvolvimento
# production → modo produção
FLASK_ENV=development

# Token de autenticação (trocar por valor seguro)
#É uma chave de autenticação da API
API_KEY=troque_por_um_token_seguro
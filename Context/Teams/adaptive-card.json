{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "style": "@{triggerBody()?['cor_card']}",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "@{triggerBody()?['icone']}",
                  "size": "ExtraLarge",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "PADS3 · MONITOR DE SEGURANÇA",
                  "weight": "Bolder",
                  "color": "Light",
                  "size": "Small",
                  "spacing": "None",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "@{triggerBody()?['titulo']}",
                  "weight": "Bolder",
                  "color": "Light",
                  "size": "Large",
                  "wrap": true,
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "@{triggerBody()?['severidade']}",
                  "weight": "Bolder",
                  "color": "Light",
                  "size": "Small",
                  "spacing": "None",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "DESCRIÇÃO",
          "weight": "Bolder",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "@{triggerBody()?['mensagem']}",
          "wrap": true,
          "size": "Default",
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "separator": true,
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "🖥️ HOST",
              "weight": "Bolder",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            },
            {
              "type": "TextBlock",
              "text": "@{triggerBody()?['origem']}",
              "size": "Default",
              "wrap": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "separator": true,
          "items": [
            {
              "type": "TextBlock",
              "text": "🕐 HORÁRIO (BRT)",
              "weight": "Bolder",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "@{triggerBody()?['timestamp']}",
              "size": "Default",
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Abrir Dashboard →",
      "url": "@{if(empty(triggerBody()?['link']), 'http://painel.monitoramento.lan', triggerBody()?['link'])}"
    }
  ]
}
